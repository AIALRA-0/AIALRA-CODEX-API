FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY openapi ./openapi
RUN pnpm install --frozen-lockfile
RUN pnpm build

FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS api
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /workspace/node_modules ./node_modules
COPY --from=build /workspace/apps/api ./apps/api
COPY --from=build /workspace/packages ./packages
COPY --from=build /workspace/openapi ./openapi
COPY --from=build /workspace/package.json ./package.json
USER node
EXPOSE 13210
CMD ["node", "apps/api/dist/main.js"]

FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS worker
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /workspace/node_modules ./node_modules
COPY --from=build /workspace/apps/worker ./apps/worker
COPY --from=build /workspace/packages ./packages
COPY --from=build /workspace/package.json ./package.json
USER node
EXPOSE 13212
CMD ["node", "apps/worker/dist/main.js"]

FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS runner
ENV NODE_ENV=production
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global @openai/codex@0.149.1
WORKDIR /app
COPY --from=build /workspace/node_modules ./node_modules
COPY --from=build /workspace/apps/runner ./apps/runner
COPY --from=build /workspace/packages ./packages
COPY --from=build /workspace/package.json ./package.json
RUN mkdir -p /workspace/jobs && chown -R node:node /workspace/jobs
USER node
EXPOSE 13214
CMD ["node", "apps/runner/dist/main.js"]

FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS web
ENV NODE_ENV=production
ENV PORT=13211
ENV HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build /workspace/apps/web/.next/standalone ./
COPY --from=build /workspace/apps/web/.next/static ./apps/web/.next/static
USER node
EXPOSE 13211
CMD ["node", "apps/web/server.js"]
