server {
    listen __TAILSCALE_IPV4__:80;
    server_name __ROUTER_HOST__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen __TAILSCALE_IPV4__:443 ssl http2;
    server_name __ROUTER_HOST__;

    ssl_certificate /etc/letsencrypt/live/__ROUTER_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__ROUTER_HOST__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    include __AUTH_ENDPOINTS_SNIPPET__;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    # Next.js generates a per-request nonce and owns the page CSP. Do not add a second policy here.

    location = /login {
        return 302 /console;
    }

    location = / {
        return 302 /console;
    }

    location ^~ /setup {
        return 404;
    }

    location ^~ /console {
        include __AUTH_PROTECT_SNIPPET__;
        include __EDGE_PROOF_SNIPPET__;
        proxy_pass http://127.0.0.1:13211;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }

    location ^~ /api/router {
        include __AUTH_PROTECT_SNIPPET__;
        include __EDGE_PROOF_SNIPPET__;
        proxy_pass http://127.0.0.1:13211;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location ~ ^/(?:api/v1|v1)(?:/|$) {
        auth_request off;
        proxy_pass http://127.0.0.1:13210;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location = /openapi.json {
        auth_request off;
        proxy_pass http://127.0.0.1:13210/openapi.json;
        proxy_set_header Host $host;
        add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'" always;
    }

    location ^~ /openapi {
        auth_request off;
        proxy_pass http://127.0.0.1:13210;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" always;
    }

    location = /healthz {
        auth_request off;
        proxy_pass http://127.0.0.1:13210/healthz;
        proxy_set_header Host $host;
    }

    location = /readyz {
        auth_request off;
        proxy_pass http://127.0.0.1:13210/readyz;
        proxy_set_header Host $host;
    }

    location / {
        include __AUTH_PROTECT_SNIPPET__;
        include __EDGE_PROOF_SNIPPET__;
        proxy_pass http://127.0.0.1:13211;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
