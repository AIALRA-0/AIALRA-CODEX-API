{
  "name": "@aialra/chatgpt-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsup src/main.ts --format esm --sourcemap --clean",
