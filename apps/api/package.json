{
  "name": "@aialra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsup src/main.ts --format esm --sourcemap --clean",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aialra/contracts": "workspace:*",
    "@aialra/persistence": "workspace:*",
    "@aialra/router": "workspace:*",
    "@aialra/security": "workspace:*",
    "@simplewebauthn/server": "latest",
    "@nestjs/common": "latest",
    "@nestjs/core": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/swagger": "latest",
    "pg-boss": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "yaml": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@nestjs/testing": "latest",
    "@types/express": "latest",
    "@types/supertest": "latest",
    "supertest": "latest"
  }
}
