# Control-plane database used by the API and worker
DATABASE_URL=postgresql://router:change-me@127.0.0.1:13213/router

# High-entropy service secret used to hash inbound API keys
API_KEY_PEPPER=replace-with-at-least-32-random-bytes

# High-entropy service secret used to hash browser sessions and recovery codes
SESSION_PEPPER=replace-with-at-least-32-random-bytes

# Base64-encoded 32-byte key used for envelope encryption
PAYLOAD_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key

# Optional initial key used only to bootstrap the first administrator
BOOTSTRAP_ADMIN_TOKEN=replace-after-first-login

# Private WebAuthn relying-party identity and HTTPS origin
WEBAUTHN_RP_ID=router-private.example.ts.net
WEBAUTHN_ORIGIN=https://router-private.example.ts.net

# Browser authentication mode: passkey for local use, authentik behind a trusted reverse proxy
AUTH_MODE=passkey
AUTHENTIK_TRUST_PROXY=false
INTERNAL_PROXY_SECRET=replace-with-a-separate-high-entropy-secret
EDGE_PROXY_SECRET=replace-with-a-different-high-entropy-secret

# Private API address consumed by the web application
MODEL_ROUTER_API_URL=http://127.0.0.1:13210

# Codex runtime configuration
CODEX_BIN=codex
CODEX_HOME=/var/lib/aialra-model-router/.codex
CODEX_AUTH_DIR=/var/lib/aialra-model-router/codex
CODEX_MAX_CONCURRENCY=1
CODEX_ADAPTER_ENABLED=true

# Experimental ChatGPT Pro visible-browser channel, disabled by default
CHATGPT_WEB_ADAPTER_ENABLED=false
CHATGPT_WEB_MAX_CONCURRENCY=1
CHATGPT_WEB_MIN_DISPATCH_INTERVAL_MS=90000
CHATGPT_CHROMIUM_NO_SANDBOX=false
CHATGPT_BROWSER_CONTROL_IP=10.253.240.2
CHATGPT_CONTROL_SUBNET=10.253.240.0/28
CHATGPT_PROXY_SUBNET=10.253.240.16/28
CHATGPT_EGRESS_SUBNET=10.253.240.32/28
# Store the bridge API token and noVNC password as files under SECRETS_DIR in production
CHATGPT_BRIDGE_API_TOKEN=replace-with-a-separate-high-entropy-secret
